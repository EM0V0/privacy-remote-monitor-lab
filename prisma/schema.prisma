// SQLite showcase DB — remote monitoring demo (Scheme A). Replace with Postgres + hardened auth for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Demo identity row — passwords stored as bcrypt hashes (never plaintext).
/// `role` is `CLINICIAN` | `PATIENT` (SQLite has no native enum in Prisma).
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  role         String       @default("CLINICIAN")
  createdAt    DateTime     @default(now())
  auditEvents  AuditEvent[]
}

/// Tamper-evident event trail for accountability demos (not a compliance guarantee).
model AuditEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// LOGIN_SUCCESS | LOGIN_FAILURE | LOGOUT | OBSERVATION_INGEST (extend as needed).
  eventType String
  actorId   String?
  subject   String?
  metadata  String?
  /// Prior entry hash (SHA-256 hex); genesis rows point at AUDIT_CHAIN_GENESIS_HASH.
  chainPrevHash String?
  /// Integrity seal over canonical payload including chainPrevHash (demo tamper-evidence).
  chainEntryHash String?
  actor     User?    @relation(fields: [actorId], references: [id])
}

/// Timestamped telemetry sample (e.g. derived movement score — illustrative only).
model Observation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  score     Float
  /// Origin label for demos: seed | api | manual.
  source    String   @default("seed")
}

/// Spend log for differential-privacy queries — supports linear ε sums plus composition bookkeeping.
model PrivacyLedger {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// Privacy loss attributed to this release (ε for Laplace mean demo).
  epsilon   Float
  /// Companion δ for (ε,δ)-DP mechanisms — pure Laplace releases use 0 in this codebase.
  delta     Float    @default(0)
  /// Mechanism tag recorded at spend time (e.g. laplace_mean) — extends to future DP primitives.
  mechanism   String   @default("laplace_mean")
  /// Renyi order α stored for Mironov Laplace RDP provenance / composition diagnostics.
  renyiOrder  Float    @default(8)
  queryType String
  metadata  String?
}

/// Structured evidence for governed aggregate release attempts.
/// AuditEvent keeps tamper evidence; this row keeps reviewer-friendly release facts.
model PrivacyRelease {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  actorId   String?
  auditEventId String?
  auditEntryHash String?
  ledgerId String?
  purpose String @default("remote_monitoring_quality_review")
  mechanism String @default("laplace_mean")
  queryType String @default("cohort_mean")
  cohortSize Int
  epsilon Float
  delta Float @default(0)
  noisyMean Float?
  trueMean Float?
  sensitivity Float?
  clipLo Float
  clipHi Float
  advancedEpsilonAfter Float?
  deltaPrime Float
  rdpGateEnabled Boolean @default(false)
  rdpAlpha Float
  rdpReportDelta Float
  status String @default("released")
  denialReason String?
  detail String?
  metadata String?
}

/// Sliding-window counters for coarse rate limiting (research-grade hygiene - not a full WAF).
model RateLimitBucket {
  id       String @id @default(cuid())
  routeKey String
  /// UNIX minute bucket (floor(epochMs / 60000)).
  windowId Int
  count    Int    @default(0)

  @@unique([routeKey, windowId])
}
