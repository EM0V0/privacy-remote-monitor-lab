# Copy to .env for local development (never commit real secrets).

DATABASE_URL="file:./dev.db"

# Password used when hashing seeded demo users (run db:seed after changing).
SHOWCASE_DEMO_PASSWORD="showcase"

# HS256 key for HttpOnly JWT sessions — required ≥16 chars in production builds.
SESSION_SECRET="change-me-to-a-long-random-string-min-16"

# Bearer secret for POST /api/v1/observations — ≥16 chars in production.
INGEST_SECRET="change-me-ingest-bearer-min-16-chars"

# Optional ops endpoint GET /api/v1/admin/audit-chain — omit locally unless you need scripted verification.
# ADMIN_AUDIT_SECRET="change-me-admin-audit-bearer-min-16-chars"

# --- Differential privacy & cohort release ---
PRIVACY_K_MIN=10
DP_EPSILON_PER_QUERY=0.5
PRIVACY_EPSILON_DAILY_CAP=4
# Advanced-composition surrogate cap (defaults to PRIVACY_EPSILON_DAILY_CAP when unset).
PRIVACY_EPSILON_COMPOSITION_CAP=4
# Slack δ′ ∈ (0,1) inside √(2k ln(1/δ′)) bookkeeping — analytic DP composition demos only.
PRIVACY_COMPOSITION_DELTA_PRIME=1e-6
DP_CLIP_MIN=0
DP_CLIP_MAX=100

# Mironov Laplace RDP bookkeeping + conversion (see README + docs/THREAT_MODEL_STRIDE.md).
PRIVACY_RDP_ALPHA=8
PRIVACY_RDP_REPORT_DELTA=1e-5
# Optional fourth gate: enforce converted (ε,δ) upper bound vs PRIVACY_EPSILON_COMPOSITION_CAP.
PRIVACY_ENABLE_RDP_GATE=0

# --- Abuse resistance (demo middleware / actions) ---
LOGIN_RATE_LIMIT_PER_MIN=45
INGEST_RATE_LIMIT_PER_MIN=240
# Browser Origin allowlist for POST /api/v1/observations (comma-separated). Leave unset or empty to skip.
# ALLOWED_ORIGINS=http://localhost:3000

# --- Monitoring algorithms (research / demo thresholds — not clinically calibrated) ---
EWMA_LAMBDA=0.25
CUSUM_SLACK=0.35
CUSUM_THRESHOLD=4
DRIFT_RECENT_WINDOW=12
DRIFT_Z_THRESHOLD=1.25
