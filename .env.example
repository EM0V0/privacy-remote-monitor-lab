# Copy to .env for local development. Never commit real secrets.

DATABASE_URL="file:./dev.db"

# Password used when hashing seeded demo users. Run db:seed after changing.
SHOWCASE_DEMO_PASSWORD="showcase"

# HS256 key for HttpOnly JWT sessions. Use at least 16 characters.
SESSION_SECRET="change-me-to-a-long-random-string-min-16"

# Bearer secret for POST /api/v1/observations. Use at least 16 characters.
INGEST_SECRET="change-me-ingest-bearer-min-16-chars"

# Optional ops endpoint: GET /api/v1/admin/audit-chain.
# ADMIN_AUDIT_SECRET="change-me-admin-audit-bearer-min-16-chars"

# --- Differential privacy and cohort release ---
PRIVACY_K_MIN=10
DP_EPSILON_PER_QUERY=0.5
PRIVACY_EPSILON_DAILY_CAP=4

# Advanced-composition surrogate cap.
# Defaults to PRIVACY_EPSILON_DAILY_CAP when unset.
PRIVACY_EPSILON_COMPOSITION_CAP=4

# Slack deltaPrime in analytic DP composition demos.
PRIVACY_COMPOSITION_DELTA_PRIME=1e-6

# Clipping bounds for mean sensitivity.
DP_CLIP_MIN=0
DP_CLIP_MAX=100

# Mironov Laplace RDP bookkeeping and conversion.
PRIVACY_RDP_ALPHA=8
PRIVACY_RDP_REPORT_DELTA=1e-5

# Optional fourth gate: enforce converted epsilon upper bound vs composition cap.
PRIVACY_ENABLE_RDP_GATE=0

# --- Abuse resistance ---
LOGIN_RATE_LIMIT_PER_MIN=45
INGEST_RATE_LIMIT_PER_MIN=240

# Browser Origin allowlist for POST /api/v1/observations. Comma-separated.
# ALLOWED_ORIGINS=http://localhost:3000

# --- Monitoring algorithms ---
# Research/demo thresholds only. They are not clinically calibrated.
EWMA_LAMBDA=0.25
CUSUM_SLACK=0.35
CUSUM_THRESHOLD=4
DRIFT_RECENT_WINDOW=12
DRIFT_Z_THRESHOLD=1.25
